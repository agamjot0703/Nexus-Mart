{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Nexus Mart: Build",
      "type": "process",
      "command": "g++",
      "args": [
        "-std=c++17",
        "-Wall",
        "-Wextra",
        "-Wpedantic",
        "-g",
        "-Iinclude",
        "src/main.cpp",
        "src/Product.cpp",
        "src/User.cpp",
        "src/ShoppingCart.cpp",
        "src/Order.cpp",
        "src/PaymentMethod.cpp",
        "src/FileManager.cpp",
        "src/Store.cpp",
        "src/ConsoleUI.cpp",
        "-o",
        "nexus_mart.exe"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$gcc",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Nexus Mart: Run",
      "type": "process",
      "command": "${workspaceFolder}\\nexus_mart.exe",
      "dependsOn": "Nexus Mart: Build",
      "dependsOrder": "sequence",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
